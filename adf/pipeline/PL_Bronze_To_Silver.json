					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT \n    MAX(CASE WHEN table_name = 'silver_patients'   THEN last_watermark_value END) AS silver_patients,\n    MAX(CASE WHEN table_name = 'silver_providers'  THEN last_watermark_value END) AS silver_providers,\n    MAX(CASE WHEN table_name = 'silver_encounters' THEN last_watermark_value END) AS silver_encounters,\n    MAX(CASE WHEN table_name = 'silver_diagnoses'  THEN last_watermark_value END) AS silver_diagnoses,\n    MAX(CASE WHEN table_name = 'silver_claims'     THEN last_watermark_value END) AS silver_claims\nFROM dbo.etl_watermark_control;\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Source",
						"type": "DatasetReference",
						"parameters": {
							"p_table_name": "etl_watermark_control"
						}
					},
					"firstRowOnly": false
				}
			},
