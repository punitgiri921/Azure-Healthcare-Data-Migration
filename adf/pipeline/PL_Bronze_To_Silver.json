			{
				"name": "LKP_Silver_Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT last_watermark_value \nFROM dbo.etl_watermark_control \nWHERE table_name = 'silver_patients';\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
