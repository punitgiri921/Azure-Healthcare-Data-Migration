					"firstRowOnly": true
				}
			},
			{
				"name": "SCR_Update_Silver_Watermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "DF_Patients_Bronze_To_Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_sqlserver_onprem",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": {
								"value": "@concat(\n'UPDATE s\nSET \n    s.last_watermark_value = b.last_watermark_value,\n    s.status = ''SUCCESS'',\n    s.last_run_timestamp = GETDATE()\nFROM dbo.etl_watermark_control s\nCROSS JOIN (\n    SELECT last_watermark_value \n    FROM dbo.etl_watermark_control \n    WHERE table_name = ''patients''\n) b\nWHERE s.table_name = ''silver_patients'''\n)\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"annotations": []
	}
