{
	"name": "PL_Bronze_To_Silver",
	"properties": {
		"activities": [
			{
				"name": "DF_Patients_Bronze_To_Silver",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "LKP_Silver_Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "DF_Patients_Bronze_To_Silver",
						"type": "DataFlowReference",
						"parameters": {
							"p_silver_last_watermark": {
								"value": "'@{activity('LKP_Silver_Watermark').output}'",
								"type": "Expression"
							}
						},
						"datasetParameters": {
							"SrcBronzePatients": {
								"p_folder_name": "dummy",
								"p_file_name": "dummy"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "LKP_Silver_Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "ParquetReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_ADLS_Silver_Patients",
						"type": "DatasetReference",
						"parameters": {
							"p_silver_last_watermark": {
								"value": "SELECT last_watermark_value \nFROM dbo.etl_watermark_control \nWHERE table_name = 'silver_patients';\n",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "SCR_Update_Silver_Watermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "DF_Patients_Bronze_To_Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_sqlserver_onprem",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": {
								"value": "@concat(\n'UPDATE dbo.etl_watermark_control\nSET \n    last_watermark_value = GETDATE(),\n    status = ''SUCCESS'',\n    last_run_timestamp = GETDATE()\nWHERE table_name = ''silver_patients'''\n)\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"annotations": []
	}
}