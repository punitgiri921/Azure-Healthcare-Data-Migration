					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_sqlserver_onprem",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": {
								"value": "@concat(\n'UPDATE s\nSET \n    s.last_watermark_value = b.last_watermark_value,\n    s.status = ''SUCCESS'',\n    s.last_run_timestamp = GETDATE()\nFROM dbo.etl_watermark_control s\nJOIN dbo.etl_watermark_control b \n  ON s.table_name = ''silver_'' + b.table_name\nWHERE s.table_name LIKE ''silver_%'''\n)\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
