{
	"name": "DF_Patients_Silver_To_Gold",
	"properties": {
		"folder": {
			"name": "To_Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Silver_Patients",
						"type": "DatasetReference"
					},
					"name": "SrcSilverPatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Gold_Dim_Patient",
						"type": "DatasetReference"
					},
					"name": "SNKGoldDimPatient"
				}
			],
			"transformations": [
				{
					"name": "DerPatientAttributes"
				},
				{
					"name": "DerPatientAgeGroup"
				},
				{
					"name": "GenPatientSK"
				},
				{
					"name": "SelDimPatient"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          ssn as string,",
				"          dob as date,",
				"          gender as string,",
				"          address as string,",
				"          city as string,",
				"          state as string,",
				"          zip as string,",
				"          insurance_id as string,",
				"          created_at as timestamp,",
				"          updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:['patients/*.parquet']) ~> SrcSilverPatients",
				"SrcSilverPatients derive(current_age = iif(isNull(dob), toInteger(null()), toInteger(year(currentDate()) - year(dob)))) ~> DerPatientAttributes",
				"DerPatientAttributes derive(age_group = case(     isNull(current_age), 'Unknown',     current_age < 18, 'Pediatric (0-17)',     current_age < 65, 'Adult (18-64)',     'Senior (65+)' ),",
				"          gold_created_at = currentUTC()) ~> DerPatientAgeGroup",
				"DerPatientAgeGroup keyGenerate(output(patient_sk as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> GenPatientSK",
				"GenPatientSK select(mapColumn(",
				"          patient_sk,",
				"          patient_id,",
				"          ssn,",
				"          first_name,",
				"          last_name,",
				"          gender,",
				"          dob,",
				"          current_age,",
				"          age_group,",
				"          address,",
				"          city,",
				"          state,",
				"          zip,",
				"          insurance_id,",
				"          created_at,",
				"          updated_at,",
				"          gold_created_at",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelDimPatient",
				"SelDimPatient sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SNKGoldDimPatient"
			]
		}
	}
}