{
	"name": "DF_Providers_Silver_To_Gold",
	"properties": {
		"folder": {
			"name": "To_Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Silver_Providers",
						"type": "DatasetReference"
					},
					"name": "SrcSilverProviders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Gold_Dim_Provider",
						"type": "DatasetReference"
					},
					"name": "SNKGoldDimProvider"
				}
			],
			"transformations": [
				{
					"name": "DerProviderAttributes"
				},
				{
					"name": "GenProviderSK"
				},
				{
					"name": "SelDimProvider"
				}
			],
			"scriptLines": [
				"source(output(",
				"          provider_id as integer,",
				"          provider_name as string,",
				"          specialty as string,",
				"          department as string,",
				"          npi_number as string,",
				"          created_at as timestamp,",
				"          updated_at as timestamp,",
				"          ingested_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:['providers/*.parquet']) ~> SrcSilverProviders",
				"SrcSilverProviders derive(gold_created_at = currentUTC()) ~> DerProviderAttributes",
				"DerProviderAttributes keyGenerate(output(provider_sk as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> GenProviderSK",
				"GenProviderSK select(mapColumn(",
				"          provider_sk,",
				"          provider_id,",
				"          provider_name,",
				"          specialty,",
				"          department,",
				"          npi_number,",
				"          gold_created_at",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelDimProvider",
				"SelDimProvider sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SNKGoldDimProvider"
			]
		}
	}
}