{
	"name": "DF_Patients_Bronze_To_Silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Bronze",
						"type": "DatasetReference"
					},
					"name": "SrcBronzePatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Silver_Patients",
						"type": "DatasetReference"
					},
					"name": "SNKSilverPatients",
					"rejectedDataLinkedService": {
						"referenceName": "ls_adls_healthcare",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "DrvMaskPHI"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          ssn as string,",
				"          dob as date,",
				"          gender as string,",
				"          address as string,",
				"          city as string,",
				"          state as string,",
				"          zip as string,",
				"          insurance_id as string,",
				"          created_at as timestamp,",
				"          updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:['patients/*.parquet']) ~> SrcBronzePatients",
				"SrcBronzePatients derive(first_name = concat(substring(first_name,1,1),'***'),",
				"          last_name = concat(substring(last_name,1,1),'*'),",
				"          ssn = sha2(256,replace(ssn,'-',''))) ~> DrvMaskPHI",
				"DrvMaskPHI sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          patient_id,",
				"          first_name,",
				"          last_name,",
				"          ssn,",
				"          dob,",
				"          gender,",
				"          address,",
				"          city,",
				"          state,",
				"          zip,",
				"          insurance_id,",
				"          created_at,",
				"          updated_at",
				"     )) ~> SNKSilverPatients"
			]
		}
	}
}