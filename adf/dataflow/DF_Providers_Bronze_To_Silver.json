{
	"name": "DF_Providers_Bronze_To_Silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Bronze",
						"type": "DatasetReference"
					},
					"name": "SrcBronzeProviders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Silver_Providers",
						"type": "DatasetReference"
					},
					"name": "SNKSilverProviders"
				}
			],
			"transformations": [
				{
					"name": "FltNewOrUpdated"
				},
				{
					"name": "DrvCleanProviders"
				}
			],
			"scriptLines": [
				"parameters{",
				"     p_silver_last_watermark as string ('1970-01-01 00:00:00.000')",
				"}",
				"source(output(",
				"          provider_id as integer,",
				"          provider_name as string,",
				"          specialty as string,",
				"          department as string,",
				"          npi_number as string,",
				"          created_at as timestamp,",
				"          updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:['providers/*.parquet']) ~> SrcBronzeProviders",
				"SrcBronzeProviders filter(isNull(updated_at) || updated_at > toTimestamp(replace(replace($p_silver_last_watermark, 'T', ' '), 'Z', ''))",
				") ~> FltNewOrUpdated",
				"FltNewOrUpdated derive(provider_name = trim(provider_name),",
				"          department = trim(department),",
				"          ingested_at = currentUTC()) ~> DrvCleanProviders",
				"DrvCleanProviders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SNKSilverProviders"
			]
		}
	}
}