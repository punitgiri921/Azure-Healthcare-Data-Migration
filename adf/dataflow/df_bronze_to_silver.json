{
	"name": "df_bronze_to_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_bronze_patients_parquet",
						"type": "DatasetReference"
					},
					"name": "SourceBronzePatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_adls_silver_patients_parquet",
						"type": "DatasetReference"
					},
					"name": "SinkSilverPatients"
				}
			],
			"transformations": [
				{
					"name": "DeriveHIPAAMasked"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          ssn as string,",
				"          dob as date,",
				"          gender as string,",
				"          address as string,",
				"          city as string,",
				"          state as string,",
				"          zip as string,",
				"          insurance_id as string,",
				"          created_at as timestamp,",
				"          updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> SourceBronzePatients",
				"SourceBronzePatients derive(ssn = sha2(256, concat(toString(ssn), 'ApexSalt2026!')),",
				"          first_name = concat(left(toString(first_name), 1), '***'),",
				"          last_name = concat(left(toString(last_name), 1), '***'),",
				"          ingested_at = currentUTC()) ~> DeriveHIPAAMasked",
				"DeriveHIPAAMasked sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SinkSilverPatients"
			]
		}
	}
}