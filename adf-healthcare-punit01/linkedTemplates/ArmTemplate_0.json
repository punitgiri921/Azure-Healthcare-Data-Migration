										"referenceName": "ls_sqlserver_onprem",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "NonQuery",
												"text": {
													"value": "@concat(\n'UPDATE dbo.etl_watermark_control\nSET\n    last_watermark_value = ''',\nactivity('LKP_Current_Watermark').output.value[0].current_watermark,\n''',\n    status = ''SUCCESS'',\n    last_run_timestamp = GETDATE()\nWHERE table_name = ''',\nitem().table_name,\n''''\n)",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
