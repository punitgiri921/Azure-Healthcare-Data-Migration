													"value": "@item().table_name",
													"type": "Expression"
												},
												"p_file_name": {
													"value": "@concat(\n    item().table_name,\n    '_',\n    formatDateTime(utcNow(),'yyyyMMddHHmmss'),\n    '.parquet'\n)",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "SCR_Update_Watermark",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "COPY_SQL_To_Bronze",
