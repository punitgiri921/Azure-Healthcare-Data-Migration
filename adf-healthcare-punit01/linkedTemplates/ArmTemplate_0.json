		{
			"name": "[concat(parameters('factoryName'), '/DF_Claims_Bronze_To_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Bronze",
								"type": "DatasetReference"
							},
							"name": "SrcBronzeClaims"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Claims",
								"type": "DatasetReference"
							},
							"name": "SNKSilverClaims"
						}
					],
					"transformations": [
						{
							"name": "FltNewOrUpdated"
						},
						{
							"name": "DrvCleanClaims"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_silver_last_watermark as string ('1970-01-01 00:00:00.000')",
						"}",
						"source(output(",
						"          claim_id as integer,",
						"          encounter_id as integer,",
						"          billed_amount as decimal(18,2),",
						"          paid_amount as decimal(18,2),",
						"          claim_status as string,",
						"          denial_reason as string,",
						"          submitted_date as date,",
						"          paid_date as date,",
						"          created_at as timestamp,",
						"          updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['claims/*.parquet']) ~> SrcBronzeClaims",
						"SrcBronzeClaims filter(isNull(updated_at) || updated_at > toTimestamp(replace(replace($p_silver_last_watermark, 'T', ' '), 'Z', ''))) ~> FltNewOrUpdated",
						"FltNewOrUpdated derive(patient_responsibility = round(billed_amount - paid_amount, 2),",
						"          is_denied = iif(claim_status == 'Denied', true(), false())) ~> DrvCleanClaims",
						"DrvCleanClaims sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SNKSilverClaims"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Bronze')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Silver_Claims')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Diagnoses_Bronze_To_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Bronze",
								"type": "DatasetReference"
							},
							"name": "SrcBronzeDiagnoses"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Diagnoses",
								"type": "DatasetReference"
							},
							"name": "SNKSilverDiagnoses"
						}
					],
					"transformations": [
						{
							"name": "FltNewOrUpdated"
						},
						{
							"name": "DrvCleanDiagnoses"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_silver_last_watermark as string ('1970-01-01 00:00:00.000')",
						"}",
						"source(output(",
						"          diagnosis_id as integer,",
						"          encounter_id as integer,",
						"          icd10_code as string,",
						"          diagnosis_description as string,",
						"          is_primary as boolean,",
						"          created_at as timestamp,",
						"          updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['diagnoses/*.parquet']) ~> SrcBronzeDiagnoses",
						"SrcBronzeDiagnoses filter(isNull(updated_at) || updated_at > toTimestamp(replace(replace($p_silver_last_watermark, 'T', ' '), 'Z', ''))) ~> FltNewOrUpdated",
						"FltNewOrUpdated derive(icd10_code = trim(upper(icd10_code)),",
						"          diagnosis_description = trim(diagnosis_description),",
						"          ingested_at = currentUTC()) ~> DrvCleanDiagnoses",
						"DrvCleanDiagnoses sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SNKSilverDiagnoses"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Bronze')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Silver_Diagnoses')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Encounters_Bronze_To_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Bronze",
								"type": "DatasetReference"
							},
							"name": "SrcBronzeEncounters"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Encounters",
								"type": "DatasetReference"
							},
							"name": "SNKSilverEncounters"
						}
					],
					"transformations": [
						{
							"name": "FltNewOrUpdated"
						},
						{
							"name": "DrvCleanEncounters"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_silver_last_watermark as string ('1970-01-01 00:00:00.000')",
						"}",
						"source(output(",
						"          encounter_id as integer,",
						"          patient_id as integer,",
						"          provider_id as integer,",
						"          admission_date as timestamp,",
						"          discharge_date as timestamp,",
						"          encounter_type as string,",
						"          department as string,",
						"          discharge_disposition as string,",
						"          created_at as timestamp,",
						"          updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['encounters/*.parquet']) ~> SrcBronzeEncounters",
						"SrcBronzeEncounters filter(isNull(updated_at) || updated_at > toTimestamp(replace(replace($p_silver_last_watermark, 'T', ' '), 'Z', ''))) ~> FltNewOrUpdated",
						"FltNewOrUpdated derive(length_of_stay_days = iif(isNull(discharge_date), 0, minus(toDate(discharge_date), toDate(admission_date))),",
						"          ingested_at = currentUTC()) ~> DrvCleanEncounters",
						"DrvCleanEncounters sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     saveOrder: 1) ~> SNKSilverEncounters"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Bronze')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Silver_Encounters')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Patients_Bronze_To_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Bronze",
								"type": "DatasetReference"
							},
							"name": "SrcBronzePatients"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "SNKSilverPatients",
							"rejectedDataLinkedService": {
								"referenceName": "ls_adls_healthcare",
								"type": "LinkedServiceReference"
							}
						}
					],
					"transformations": [
						{
							"name": "DrvMaskPHI"
						},
						{
							"name": "FltNewOrUpdated"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_silver_last_watermark as string ('1970-01-01 00:00:00.000')",
						"}",
						"source(output(",
						"          patient_id as integer,",
						"          first_name as string,",
						"          last_name as string,",
						"          ssn as string,",
						"          dob as date,",
						"          gender as string,",
						"          address as string,",
						"          city as string,",
						"          state as string,",
						"          zip as string,",
						"          insurance_id as string,",
						"          created_at as timestamp,",
						"          updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['patients/*.parquet']) ~> SrcBronzePatients",
						"FltNewOrUpdated derive(first_name = concat(substring(first_name,1,1),'***'),",
						"          last_name = concat(substring(last_name,1,1),'*'),",
						"          ssn = sha2(256,replace(ssn,'-',''))) ~> DrvMaskPHI",
						"SrcBronzePatients filter(isNull(updated_at) || updated_at > toTimestamp(replace(replace($p_silver_last_watermark, 'T', ' '), 'Z', ''))) ~> FltNewOrUpdated",
						"DrvMaskPHI sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          patient_id,",
						"          first_name,",
						"          last_name,",
						"          ssn,",
						"          dob,",
						"          gender,",
						"          address,",
						"          city,",
						"          state,",
						"          zip,",
