		{
			"name": "[concat(parameters('factoryName'), '/PL_Ingest_Bronze')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LKP_Get_Watermark_Control",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": "SELECT\n    table_name,\n    watermark_column,\n    last_watermark_value\nFROM dbo.etl_watermark_control\nWHERE status = 'SUCCESS'\n  AND table_name NOT LIKE 'silver_%'\n  AND table_name NOT LIKE 'gold_%';",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_Source",
								"type": "DatasetReference",
								"parameters": {
									"p_table_name": "etl_watermark_control"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "FE_Table_Load",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "LKP_Get_Watermark_Control",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('LKP_Get_Watermark_Control').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "LKP_Current_Watermark",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlServerSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT MAX(',\n    item().watermark_column,\n    ') AS current_watermark FROM dbo.',\n    item().table_name\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_SQL_Source",
											"type": "DatasetReference",
											"parameters": {
												"p_table_name": {
													"value": "@item().table_name",
													"type": "Expression"
												}
											}
										},
										"firstRowOnly": false
									}
								},
								{
									"name": "COPY_SQL_To_Bronze",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "LKP_Current_Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlServerSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT * FROM dbo.',\n    item().table_name,\n    ' WHERE updated_at > ''',\n    item().last_watermark_value,\n    ''' AND updated_at <= ''',\n    activity('LKP_Current_Watermark').output.value[0].current_watermark,\n    ''''\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_SQL_Source",
											"type": "DatasetReference",
											"parameters": {
												"p_table_name": {
													"value": "@item().table_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_Bronze",
											"type": "DatasetReference",
											"parameters": {
												"p_folder_name": {
													"value": "@item().table_name",
													"type": "Expression"
												},
												"p_file_name": {
													"value": "@concat(\n    item().table_name,\n    '_',\n    formatDateTime(utcNow(),'yyyyMMddHHmmss'),\n    '.parquet'\n)",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "SCR_Update_Watermark",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "COPY_SQL_To_Bronze",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "ls_sqlserver_onprem",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "NonQuery",
												"text": {
													"value": "@concat(\n'UPDATE dbo.etl_watermark_control\nSET\n    last_watermark_value = ''',\nactivity('LKP_Current_Watermark').output.value[0].current_watermark,\n''',\n    status = ''SUCCESS'',\n    last_run_timestamp = GETDATE()\nWHERE table_name = ''',\nitem().table_name,\n''''\n)",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": []
		},
