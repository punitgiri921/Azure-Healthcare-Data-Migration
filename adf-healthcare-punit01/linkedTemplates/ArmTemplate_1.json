{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-healthcare-punit01"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_Diagnoses_Silver_To_Gold')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "To_Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Diagnoses",
								"type": "DatasetReference"
							},
							"name": "SrcSilverDiagnoses"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Gold_Dim_Diagnosis",
								"type": "DatasetReference"
							},
							"name": "SNKGoldDimDiagnosis"
						}
					],
					"transformations": [
						{
							"name": "DerDiagnosisAttributes"
						},
						{
							"name": "GenDiagnosisSK"
						},
						{
							"name": "SelDimDiagnosis"
						}
					],
					"scriptLines": [
						"source(output(",
						"          diagnosis_id as integer,",
						"          encounter_id as integer,",
						"          icd10_code as string,",
						"          diagnosis_description as string,",
						"          is_primary as boolean,",
						"          created_at as timestamp,",
						"          updated_at as timestamp,",
						"          ingested_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['diagnoses/*.parquet']) ~> SrcSilverDiagnoses",
						"SrcSilverDiagnoses derive(gold_created_at = currentUTC()) ~> DerDiagnosisAttributes",
						"DerDiagnosisAttributes keyGenerate(output(diagnosis_sk as long),",
						"     startAt: 1L,",
						"     stepValue: 1L) ~> GenDiagnosisSK",
						"GenDiagnosisSK select(mapColumn(",
						"          diagnosis_sk,",
						"          diagnosis_id,",
						"          icd10_code,",
						"          diagnosis_description,",
						"          is_primary,",
						"          gold_created_at",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelDimDiagnosis",
						"SelDimDiagnosis sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SNKGoldDimDiagnosis"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Encounters_Bronze_To_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Bronze",
								"type": "DatasetReference"
							},
							"name": "SrcBronzeEncounters"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Encounters",
								"type": "DatasetReference"
							},
							"name": "SNKSilverEncounters"
						}
					],
					"transformations": [
						{
							"name": "FltNewOrUpdated"
						},
						{
							"name": "DrvCleanEncounters"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_silver_last_watermark as string ('1970-01-01 00:00:00.000')",
						"}",
						"source(output(",
						"          encounter_id as integer,",
						"          patient_id as integer,",
						"          provider_id as integer,",
						"          admission_date as timestamp,",
						"          discharge_date as timestamp,",
						"          encounter_type as string,",
						"          department as string,",
						"          discharge_disposition as string,",
						"          created_at as timestamp,",
						"          updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['encounters/*.parquet']) ~> SrcBronzeEncounters",
						"SrcBronzeEncounters filter(isNull(updated_at) || updated_at > toTimestamp(replace(replace($p_silver_last_watermark, 'T', ' '), 'Z', ''))) ~> FltNewOrUpdated",
						"FltNewOrUpdated derive(length_of_stay_days = iif(isNull(discharge_date), 0, minus(toDate(discharge_date), toDate(admission_date))),",
						"          ingested_at = currentUTC()) ~> DrvCleanEncounters",
						"DrvCleanEncounters sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     saveOrder: 1) ~> SNKSilverEncounters"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Encounters_Silver_To_Gold')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "To_Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Encounters",
								"type": "DatasetReference"
							},
							"name": "SrcSilverEncounters"
						},
						{
							"dataset": {
								"referenceName": "DS_ADLS_Gold_Dim_Patient",
								"type": "DatasetReference"
							},
							"name": "SrcDimPatient"
						},
						{
							"dataset": {
								"referenceName": "DS_ADLS_Gold_Dim_Provider",
								"type": "DatasetReference"
							},
							"name": "SrcDimProvider"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Gold_Fact_Encounters",
								"type": "DatasetReference"
							},
							"name": "SNKGoldFactEncounters"
						}
					],
					"transformations": [
						{
							"name": "LkpPatientSK"
						},
						{
							"name": "LkpProviderSK"
						},
						{
							"name": "GenEncounterSK"
						},
						{
							"name": "SelFactColumns"
						},
						{
							"name": "DerEncounterAttributes"
						}
					],
					"scriptLines": [
						"source(output(",
						"          encounter_id as integer,",
						"          patient_id as integer,",
						"          provider_id as integer,",
						"          admission_date as timestamp,",
						"          discharge_date as timestamp,",
						"          encounter_type as string,",
						"          department as string,",
						"          discharge_disposition as string,",
						"          created_at as timestamp,",
						"          updated_at as timestamp,",
						"          length_of_stay_days as integer,",
						"          ingested_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['encounters/*.parquet']) ~> SrcSilverEncounters",
						"source(output(",
						"          patient_sk as long,",
						"          patient_id as integer,",
						"          ssn as string,",
						"          first_name as string,",
						"          last_name as string,",
						"          gender as string,",
						"          dob as date,",
						"          current_age as integer,",
						"          age_group as string,",
						"          address as string,",
						"          city as string,",
						"          state as string,",
						"          zip as string,",
						"          insurance_id as string,",
						"          created_at as timestamp,",
						"          updated_at as timestamp,",
						"          gold_created_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['dim_patient/*.parquet']) ~> SrcDimPatient",
						"source(output(",
						"          provider_sk as long,",
						"          provider_id as integer,",
						"          provider_name as string,",
						"          specialty as string,",
						"          department as string,",
						"          npi_number as string,",
						"          gold_created_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['dim_provider/*.parquet']) ~> SrcDimProvider",
						"SrcSilverEncounters, SrcDimPatient join(SrcSilverEncounters@patient_id == SrcDimPatient@patient_id,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> LkpPatientSK",
						"LkpPatientSK, SrcDimProvider lookup(SrcSilverEncounters@provider_id == SrcDimProvider@provider_id,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> LkpProviderSK",
						"SelFactColumns keyGenerate(output(encounter_sk as long),",
						"     startAt: 1L,",
						"     stepValue: 1L) ~> GenEncounterSK",
						"LkpProviderSK select(mapColumn(",
						"          encounter_id,",
						"          patient_sk,",
						"          provider_sk,",
						"          admission_date,",
						"          discharge_date,",
						"          encounter_type,",
						"          department = SrcSilverEncounters@department,",
						"          discharge_disposition,",
						"          length_of_stay_days",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelFactColumns",
						"GenEncounterSK derive(gold_created_at = currentUTC()) ~> DerEncounterAttributes",
						"DerEncounterAttributes sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SNKGoldFactEncounters"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Patients_Bronze_To_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Bronze",
								"type": "DatasetReference"
							},
							"name": "SrcBronzePatients"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "SNKSilverPatients",
							"rejectedDataLinkedService": {
								"referenceName": "ls_adls_healthcare",
								"type": "LinkedServiceReference"
							}
						}
					],
					"transformations": [
						{
							"name": "DrvMaskPHI"
						},
						{
							"name": "FltNewOrUpdated"
						}
					],
					"scriptLines": [
						"parameters{",
						"     p_silver_last_watermark as string ('1970-01-01 00:00:00.000')",
						"}",
						"source(output(",
						"          patient_id as integer,",
						"          first_name as string,",
						"          last_name as string,",
						"          ssn as string,",
						"          dob as date,",
						"          gender as string,",
						"          address as string,",
						"          city as string,",
						"          state as string,",
						"          zip as string,",
						"          insurance_id as string,",
						"          created_at as timestamp,",
						"          updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['patients/*.parquet']) ~> SrcBronzePatients",
						"FltNewOrUpdated derive(first_name = concat(substring(first_name,1,1),'***'),",
						"          last_name = concat(substring(last_name,1,1),'*'),",
						"          ssn = sha2(256,replace(ssn,'-',''))) ~> DrvMaskPHI",
						"SrcBronzePatients filter(isNull(updated_at) || updated_at > toTimestamp(replace(replace($p_silver_last_watermark, 'T', ' '), 'Z', ''))) ~> FltNewOrUpdated",
						"DrvMaskPHI sink(allowSchemaDrift: true,",
						"     validateSchema: true,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          patient_id,",
						"          first_name,",
						"          last_name,",
						"          ssn,",
						"          dob,",
						"          gender,",
						"          address,",
						"          city,",
						"          state,",
						"          zip,",
						"          insurance_id,",
						"          created_at,",
						"          updated_at",
						"     )) ~> SNKSilverPatients"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Patients_Silver_To_Gold')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "To_Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "SrcSilverPatients"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Gold_Dim_Patient",
								"type": "DatasetReference"
							},
							"name": "SNKGoldDimPatient"
						}
					],
					"transformations": [
						{
							"name": "DerPatientAttributes"
						},
						{
							"name": "DerPatientAgeGroup"
						},
						{
							"name": "GenPatientSK"
						},
						{
							"name": "SelDimPatient"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as integer,",
						"          first_name as string,",
						"          last_name as string,",
						"          ssn as string,",
						"          dob as date,",
						"          gender as string,",
						"          address as string,",
						"          city as string,",
						"          state as string,",
						"          zip as string,",
						"          insurance_id as string,",
						"          created_at as timestamp,",
						"          updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet',",
						"     wildcardPaths:['patients/*.parquet']) ~> SrcSilverPatients",
						"SrcSilverPatients derive(current_age = iif(isNull(dob), toInteger(null()), toInteger(year(currentDate()) - year(dob)))) ~> DerPatientAttributes",
						"DerPatientAttributes derive(age_group = case(     isNull(current_age), 'Unknown',     current_age < 18, 'Pediatric (0-17)',     current_age < 65, 'Adult (18-64)',     'Senior (65+)' ),",
						"          gold_created_at = currentUTC()) ~> DerPatientAgeGroup",
						"DerPatientAgeGroup keyGenerate(output(patient_sk as long),",
						"     startAt: 1L,",
						"     stepValue: 1L) ~> GenPatientSK",
						"GenPatientSK select(mapColumn(",
						"          patient_sk,",
						"          patient_id,",
						"          ssn,",
						"          first_name,",
						"          last_name,",
						"          gender,",
						"          dob,",
						"          current_age,",
						"          age_group,",
						"          address,",
						"          city,",
						"          state,",
						"          zip,",
						"          insurance_id,",
						"          created_at,",
						"          updated_at,",
						"          gold_created_at",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelDimPatient",
						"SelDimPatient sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SNKGoldDimPatient"
					]
				}
			},
			"dependsOn": []
		},
