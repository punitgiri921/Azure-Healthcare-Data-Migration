        <!-- TITLE BAR -->
        <mxCell id="title" value="Azure Healthcare Data Migration &amp; Medallion Lakehouse&#xa;Master Dynamic Metadata-Driven Ingestion Blueprint: Phase 3 &amp; Parameterized Orchestration" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="120" y="25" width="1560" height="50" as="geometry" />
        </mxCell>

        <mxCell id="subtitle" value="Parent Orchestrator (pl_master_ingest_bronze) ➔ ForEach Loop ➔ Parameterized Child Pipeline (pl_ingest_incremental_bronze) ➔ ADLS Gen2 Bronze Parquet" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="1300" height="25" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- ZONE 1: ON-PREMISES SOURCE ENVIRONMENT                                    -->
        <!-- ========================================================================= -->
        <mxCell id="z-onprem" value="🏢 ON-PREMISES CLINICAL ENVIRONMENT (Hospital LAN / Private Workstation)&#xa;Host: DESKTOP-H5RKB3H  |  Private Workstation  |  Zero Inbound Ports" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1E293B;fontSize=13;fontStyle=1;fontFamily=Helvetica;startSize=40;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="480" height="980" as="geometry" />
        </mxCell>

        <!-- SQL Server Database -->
        <mxCell id="z-sql" value="🗄️ SQL Server 2022 Express (.\SQLEXPRESS)&#xa;Database: healthcare_emr_source (Port 1433)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#92400E;fontSize=12;fontStyle=1;fontFamily=Helvetica;startSize=40;rounded=1;" vertex="1" parent="z-onprem">
          <mxGeometry x="20" y="55" width="440" height="490" as="geometry" />
        </mxCell>

        <mxCell id="sql-tables" value="📋 All 5 Seeded Clinical EMR Tables (Target of ForEach):&#xa;• dbo.patients (20 rows) ➔ PII Target for Silver Masking&#xa;• dbo.providers (10 rows) ➔ Doctor &amp; Staff Dimension&#xa;• dbo.encounters (15 rows) ➔ Clinical Inpatient/Outpatient&#xa;• dbo.diagnoses (17 rows) ➔ ICD-10 Clinical Codes&#xa;• dbo.claims (15 rows) ➔ Billing &amp; Settlement Facts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;fontColor=#451A03;fontSize=10.5;align=left;spacingLeft=10;lineHeight=1.4;" vertex="1" parent="z-sql">
          <mxGeometry x="15" y="50" width="410" height="105" as="geometry" />
        </mxCell>

        <mxCell id="sql-control" value="⏱️ State Control Engine: [dbo.etl_watermark_control]&#xa;• Dynamic Metadata Table Queried by Parent Pipeline:&#xa;  1. claims       | updated_at | 2024-03-10 14:30:00 | SUCCESS&#xa;  2. diagnoses    | updated_at | 2024-02-19 07:00:00 | SUCCESS&#xa;  3. encounters   | updated_at | 2024-02-23 15:30:00 | SUCCESS&#xa;  4. patients     | updated_at | 2024-01-24 13:25:00 | SUCCESS&#xa;  5. providers    | updated_at | 2024-01-01 08:00:00 | SUCCESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontColor=#064E3B;fontSize=10;align=left;spacingLeft=10;fontStyle=1;lineHeight=1.4;" vertex="1" parent="z-sql">
          <mxGeometry x="15" y="165" width="410" height="135" as="geometry" />
        </mxCell>

        <mxCell id="sql-proc" value="⚙️ Watermark Stored Procedure: [dbo.usp_update_watermark]&#xa;• Executed dynamically: EXEC dbo.usp_update_watermark&#xa;  @TableName = @pipeline().parameters.TableName,&#xa;  @NewWatermarkValue = @activity('LookupNewWatermark')...&#xa;• Atomic ACID Update: Updates status = 'SUCCESS' only after copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="z-sql">
          <mxGeometry x="15" y="310" width="410" height="85" as="geometry" />
        </mxCell>

        <mxCell id="sql-user" value="👤 Service Principal: [adf_svc_user]&#xa;Roles: db_datareader + EXECUTE ON dbo.usp_update_watermark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="z-sql">
          <mxGeometry x="15" y="405" width="410" height="40" as="geometry" />
        </mxCell>

        <!-- SHIR Box -->
        <mxCell id="z-shir" value="🌉 HYBRID GATEWAY: Self-Hosted Integration Runtime (SHIR)&#xa;Name: shir-onprem-gateway-01  |  Daemon: DIAHostService" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1.5;fontColor=#065F46;fontSize=12;fontStyle=1;fontFamily=Helvetica;startSize=40;rounded=1;" vertex="1" parent="z-onprem">
          <mxGeometry x="20" y="565" width="440" height="230" as="geometry" />
        </mxCell>

        <mxCell id="shir-details" value="• Polling Model: Initiates outbound HTTPS on TCP 443 to ADF&#xa;• Queries Local SQL: Executes parameterized queries via ODBC&#xa;• Edge Compute: Serializes SQL records into Snappy Parquet in-memory&#xa;• Parallel Stream: Handles parallel copy threads without cloud ingress&#xa;• Perimeter Security: Zero inbound ports opened on hospital firewall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontColor=#047857;fontSize=10.5;align=left;spacingLeft=10;lineHeight=1.5;" vertex="1" parent="z-shir">
          <mxGeometry x="15" y="50" width="410" height="115" as="geometry" />
        </mxCell>

        <mxCell id="shir-verified" value="🟢 All 5 Child Runs Successfully Succeeded via SHIR Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="z-shir">
          <mxGeometry x="15" y="175" width="410" height="35" as="geometry" />
        </mxCell>

        <mxCell id="onprem-guard" value="🛡️ HIPAA § 164.312 Compliance: Private clinical records are encrypted with TLS 1.3 during cloud transit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#F87171;fontColor=#991B1B;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="z-onprem">
          <mxGeometry x="20" y="820" width="440" height="50" as="geometry" />
        </mxCell>


        <!-- ========================================================================= -->
        <!-- ZONE 2: ADF DYNAMIC ORCHESTRATION PIPELINES                               -->
        <!-- ========================================================================= -->
        <mxCell id="z-adf" value="🚀 AZURE DATA FACTORY: [adf-healthcare-punit01] (System-Assigned Managed Identity)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1D4ED8;fontSize=13;fontStyle=1;fontFamily=Helvetica;startSize=40;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="120" width="750" height="980" as="geometry" />
        </mxCell>

        <!-- Master Pipeline Swimlane -->
        <mxCell id="box-master" value="👑 PARENT PIPELINE: [pl_master_ingest_bronze]&#xa;Orchestrates Dynamic Metadata Execution" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E40AF;fontSize=11.5;fontStyle=1;fontFamily=Helvetica;startSize=40;rounded=1;" vertex="1" parent="z-adf">
          <mxGeometry x="20" y="55" width="710" height="280" as="geometry" />
        </mxCell>

        <!-- Master Activity 1: Lookup -->
        <mxCell id="m-act-lookup" value="🔍 Activity 1: GetTableMetadata (Lookup)&#xa;• Dataset: ds_sql_watermark_control&#xa;• First row only: UNCHECKED ❌&#xa;• Query: SELECT table_name, watermark_column&#xa;  FROM dbo.etl_watermark_control;&#xa;• Output: Array of 5 Table Objects [ {claims}, {diagnoses}... ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=10;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="box-master">
          <mxGeometry x="20" y="55" width="310" height="110" as="geometry" />
        </mxCell>

        <!-- Master Activity 2: ForEach -->
        <mxCell id="m-act-foreach" value="🔁 Activity 2: ForEachTable (ForEach Loop)&#xa;• Items: @activity('GetTableMetadata').output.value&#xa;• Batch: Executes 5 Child Ingestion Pipelines&#xa;• Inside Loop: Execute Pipeline (TriggerTableIngest)&#xa;  - Param TableName = @item().table_name&#xa;  - Param WatermarkColumn = @item().watermark_column" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;fontSize=10;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="box-master">
          <mxGeometry x="380" y="55" width="310" height="110" as="geometry" />
        </mxCell>

        <!-- Arrow Master Lookup to ForEach -->
        <mxCell id="arr-m1" value="Pass Array of Tables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E40AF;fontStyle=1;" edge="1" parent="box-master" source="m-act-lookup" target="m-act-foreach">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="m-stats" value="🟢 Master Execution Result: Status Succeeded (Total Duration: 4m 9s for all 5 tables)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="box-master">
          <mxGeometry x="20" y="210" width="670" height="35" as="geometry" />
        </mxCell>


        <!-- Child Pipeline Swimlane -->
        <mxCell id="box-child" value="⚙️ PARAMETERIZED CHILD PIPELINE: [pl_ingest_incremental_bronze]&#xa;Parameters: TableName (String)  |  WatermarkColumn (String)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11.5;fontStyle=1;fontFamily=Helvetica;startSize=40;rounded=1;" vertex="1" parent="z-adf">
          <mxGeometry x="20" y="360" width="710" height="490" as="geometry" />
        </mxCell>

        <!-- Child Act 1: Lookup Old -->
        <mxCell id="c-act-lookold" value="🔍 LookupOldWatermark&#xa;Query: @concat('SELECT last_watermark_value &#xa;FROM dbo.etl_watermark_control &#xa;WHERE table_name = ''', &#xa;pipeline().parameters.TableName, '''')&#xa;First row only: TRUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;spacingLeft=8;" vertex="1" parent="box-child">
          <mxGeometry x="20" y="55" width="280" height="95" as="geometry" />
        </mxCell>

        <!-- Child Act 2: Lookup New -->
        <mxCell id="c-act-looknew" value="🔍 LookupNewWatermark&#xa;Query: @concat('SELECT ISNULL(MAX(', &#xa;pipeline().parameters.WatermarkColumn, &#xa;'), ''1970-01-01'') AS new_watermark &#xa;FROM dbo.', pipeline().parameters.TableName)&#xa;First row only: TRUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=9.5;align=left;spacingLeft=8;" vertex="1" parent="box-child">
          <mxGeometry x="410" y="55" width="280" height="95" as="geometry" />
        </mxCell>

        <!-- Child Act 3: Copy Activity -->
        <mxCell id="c-act-copy" value="📦 CopyIncrementalData (Copy Activity)&#xa;• Source Query: @concat('SELECT * FROM dbo.', pipeline().parameters.TableName, &#xa;  ' WHERE ', pipeline().parameters.WatermarkColumn, ' &gt; ''', activity('LookupOldWatermark').output..., &#xa;  ''' AND ', pipeline().parameters.WatermarkColumn, ' &lt;= ''', activity('LookupNewWatermark').output..., '''')&#xa;• Sink: ds_adls_bronze_parquet (Parameter: folderName = @pipeline().parameters.TableName)&#xa;• Destination Path: bronze / @{pipeline().parameters.TableName} / *.parquet (Snappy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=10;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="box-child">
          <mxGeometry x="20" y="195" width="670" height="110" as="geometry" />
        </mxCell>

        <!-- Child Act 4: Stored Proc -->
        <mxCell id="c-act-sp" value="⚡ UpdateWatermark (Stored Procedure Activity)&#xa;• Stored Proc: [dbo].[usp_update_watermark]&#xa;• Param @TableName = @pipeline().parameters.TableName&#xa;• Param @NewWatermarkValue = @activity('LookupNewWatermark').output.firstRow.new_watermark&#xa;• Condition: Strictly executes ONLY upon Copy Activity SUCCESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="box-child">
          <mxGeometry x="20" y="345" width="670" height="85" as="geometry" />
        </mxCell>

        <!-- Arrows in Child -->
        <mxCell id="arr-c1" value="Success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;fontSize=9.5;fontColor=#065F46;fontStyle=1;" edge="1" parent="box-child" source="c-act-lookold" target="c-act-copy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr-c2" value="Success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;fontSize=9.5;fontColor=#065F46;fontStyle=1;" edge="1" parent="box-child" source="c-act-looknew" target="c-act-copy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr-c3" value="Success (Commit)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;fontSize=9.5;fontColor=#065F46;fontStyle=1;" edge="1" parent="box-child" source="c-act-copy" target="c-act-sp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow Master ForEach to Child Pipeline -->
        <mxCell id="arr-invoke" value="ForEach Invokes Child (x5 iterations)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=2.5;fontSize=10.5;fontColor=#B45309;fontStyle=1;dashed=1;" edge="1" parent="z-adf" source="m-act-foreach" target="box-child">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


