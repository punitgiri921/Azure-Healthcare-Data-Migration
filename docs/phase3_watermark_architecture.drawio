  <diagram id="phase3-master-incremental-architecture" name="Phase 3 Dynamic Watermark Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="#FFFFFF">
      <root>
