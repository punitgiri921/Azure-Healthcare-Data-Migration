        <!-- Activity 1: Lookup Old -->
        <mxCell id="act-look-old" value="🔍 Activity 1 (Lookup): [LookupOldWatermark]&#xa;• Dataset: ds_sql_watermark_control&#xa;• ConnectVia: shir-onprem-gateway-01&#xa;• SQL: SELECT last_watermark_value FROM dbo.etl_watermark_control WHERE table_name = 'encounters'&#xa;• Result: '1970-01-01 00:00:00' (🟢 Succeeded - 17s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;fontColor=#065F46;fontSize=10;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="pipe-box">
          <mxGeometry x="20" y="60" width="520" height="80" as="geometry" />
        </mxCell>

        <!-- Activity 2: Lookup New -->
        <mxCell id="act-look-new" value="🔍 Activity 2 (Lookup): [LookupNewWatermark]&#xa;• Dataset: ds_sql_encounters&#xa;• ConnectVia: shir-onprem-gateway-01&#xa;• SQL: SELECT ISNULL(MAX(updated_at), '1970-01-01') AS new_watermark FROM dbo.encounters&#xa;• Result: '2024-02-23 15:30:00.000' (🟢 Succeeded - 19s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;fontColor=#065F46;fontSize=10;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="pipe-box">
          <mxGeometry x="20" y="160" width="520" height="80" as="geometry" />
        </mxCell>

        <!-- Activity 3: Copy Activity -->
        <mxCell id="act-copy" value="📦 Activity 3 (Copy Data): [CopyIncrementalEncounters]&#xa;• Source: ds_sql_encounters (Dynamic Delta Query)&#xa;  WHERE updated_at &gt; '@{LookupOldWatermark}' AND updated_at &lt;= '@{LookupNewWatermark}'&#xa;• Sink: ds_adls_bronze_parquet (sthealthcarelake01 / bronze / encounters /)&#xa;• Format: Parquet with Snappy Compression&#xa;• Metrics: 15 Rows Read ➔ 15 Rows Copied (🟢 Succeeded - 18s via SHIR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=10;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="pipe-box">
          <mxGeometry x="20" y="270" width="520" height="110" as="geometry" />
        </mxCell>

        <!-- Activity 4: Stored Procedure -->
