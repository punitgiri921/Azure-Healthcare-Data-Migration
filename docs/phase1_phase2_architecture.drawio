        <!-- ZONE 2: MICROSOFT AZURE CLOUD                                             -->
        <!-- ========================================================================= -->
        <mxCell id="azure-box" value="☁️ MICROSOFT AZURE CLOUD PLATFORM&#xa;Subscription: Azure Free Trial ($200 Credit)  |  Resource Group: rg-healthcare-migration-prod (Central India)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;fontSize=14;fontStyle=1;fontFamily=Helvetica;startSize=40;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="760" height="960" as="geometry" />
        </mxCell>

        <!-- Azure Key Vault -->
        <mxCell id="akv-box" value="🔐 Azure Key Vault: [kv-healthcare-sec01] (Phase 1 Task P1-T4 &amp; Phase 2 Task P2-T6)&#xa;Security Boundary: Azure RBAC Permission Model | Zero Secret Hardcoding" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#6B21A8;fontSize=12;fontStyle=1;fontFamily=Helvetica;startSize=45;rounded=1;" vertex="1" parent="azure-box">
          <mxGeometry x="30" y="60" width="700" height="170" as="geometry" />
        </mxCell>

        <mxCell id="akv-content" value="• Secret Stored: [sql-onprem-password] ➔ Value: HealthLakehouse2026!Secure (Created via Key Vault Secrets Officer)&#xa;• Access Control (IAM) Data Plane RBAC Roles Configured:&#xa;   1. You (Arpit/Punit): [Key Vault Secrets Officer] ➔ Enables creating and viewing secrets in portal without access keys&#xa;   2. ADF (adf-healthcare-punit01): [Key Vault Secrets User] ➔ Read-only token access for pipelines without admin powers&#xa;• Architectural Benefit: Passwords never touch Git commits, scripts, or Data Factory pipeline JSON definitions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D5FF;fontColor=#581C87;fontSize=11;align=left;spacingLeft=12;lineHeight=1.4;" vertex="1" parent="akv-box">
          <mxGeometry x="15" y="55" width="670" height="100" as="geometry" />
        </mxCell>

        <!-- ADLS Gen2 Storage Account -->
        <mxCell id="adls-box" value="🛢️ Azure Data Lake Storage Gen2: [sthealthcarelake01] (Phase 1 Tasks P1-T2 &amp; P1-T3)&#xa;Storage Kind: StorageV2 (General Purpose v2) | Performance: Standard LRS | Hierarchical Namespace (HNS): ENABLED" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#06B6D4;strokeWidth=1.5;fontColor=#0E7490;fontSize=12;fontStyle=1;fontFamily=Helvetica;startSize=45;rounded=1;" vertex="1" parent="azure-box">
          <mxGeometry x="30" y="250" width="700" height="190" as="geometry" />
        </mxCell>

        <!-- Bronze Container -->
        <mxCell id="c-bronze" value="🥉 [bronze] Container&#xa;Raw Ingestion Layer&#xa;• Parquet format&#xa;• Partitioned by YYYY/MM&#xa;• Append-only source audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="adls-box">
          <mxGeometry x="20" y="55" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- Silver Container -->
        <mxCell id="c-silver" value="🥈 [silver] Container&#xa;Cleansed &amp; De-identified&#xa;• Delta Lake format&#xa;• SHA-256 Masked SSN&#xa;• Deduplicated clinical visits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="adls-box">
          <mxGeometry x="250" y="55" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- Gold Container -->
        <mxCell id="c-gold" value="🥇 [gold] Container&#xa;Curated Star Schema Marts&#xa;• Fact_Encounters, Fact_Claims&#xa;• Dim_Patient, Dim_Provider&#xa;• Power BI Reporting Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="adls-box">
          <mxGeometry x="480" y="55" width="200" height="75" as="geometry" />
        </mxCell>

        <mxCell id="adls-rbac" value="🔑 RBAC Permission Applied (Task P1-T6): ADF Managed Identity granted [Storage Blob Data Contributor]&#xa;Why HNS Matters: Atomic O(1) directory moves during pipeline partition writes; POSIX access control down to folder level." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5F3FC;fontColor=#164E63;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="adls-box">
          <mxGeometry x="20" y="140" width="660" height="40" as="geometry" />
        </mxCell>

        <!-- Azure Data Factory -->
        <mxCell id="adf-box" value="🏭 Azure Data Factory v2: [adf-healthcare-punit01] (Phase 1 Task P1-T5 &amp; Phase 2 Task P2-T7)&#xa;Identity: System-Assigned Managed Identity (SMI) Enabled | Git Integrated" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E40AF;fontSize=12;fontStyle=1;fontFamily=Helvetica;startSize=45;rounded=1;" vertex="1" parent="azure-box">
          <mxGeometry x="30" y="460" width="700" height="340" as="geometry" />
        </mxCell>

        <!-- Linked Service 1 -->
        <mxCell id="ls-akv" value="🔗 Linked Service: [ls_keyvault_healthcare]&#xa;• Connects To: kv-healthcare-sec01&#xa;• Auth: Managed Identity (No keys)&#xa;• Used For: Retrieving DB password dynamically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="adf-box">
          <mxGeometry x="20" y="60" width="315" height="70" as="geometry" />
        </mxCell>

        <!-- Linked Service 2 -->
        <mxCell id="ls-sql" value="🔗 Linked Service: [ls_sqlserver_onprem]&#xa;• Connects To: DESKTOP-H5RKB3H\SQLEXPRESS&#xa;• Gateway: shir-onprem-gateway-01&#xa;• User: adf_svc_user (Password from Key Vault)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="adf-box">
          <mxGeometry x="365" y="60" width="315" height="70" as="geometry" />
        </mxCell>

        <!-- Pipeline Preview Box -->
        <mxCell id="pipe-preview" value="🚀 UPCOMING IN PHASE 3: [pl_ingest_incremental_bronze]&#xa;1. Lookup Old Watermark ➔ 2. Lookup New Max Source Timestamp ➔ 3. Copy Delta Rows ➔ 4. Update Watermark Control Table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="adf-box">
          <mxGeometry x="20" y="145" width="660" height="40" as="geometry" />
        </mxCell>

        <!-- Future Pipeline Steps -->
        <mxCell id="adf-layers" value="🔄 Medallion Pipelines &amp; Analytics Serving (Phases 3 – 5):&#xa;• Ingestion Copy Activity (Phase 3): On-Prem SQL ➔ Bronze Parquet (Delta Window: updated_at &gt; LastWatermark)&#xa;• Mapping Data Flow (Phase 4): Bronze ➔ Silver (HIPAA SHA-256 Masking on SSN &amp; Name, Schema Casting, Null Handling)&#xa;• Dimensional Modeling Data Flow (Phase 4): Silver ➔ Gold Star Schema (Conformed Dims &amp; Fact Tables in Delta)&#xa;• Synapse Serverless SQL (Phase 5): Direct T-SQL query views over Gold Delta tables for Power BI reporting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;lineHeight=1.4;" vertex="1" parent="adf-box">
          <mxGeometry x="20" y="200" width="660" height="120" as="geometry" />
        </mxCell>

        <!-- GitHub Integration Box -->
        <mxCell id="gh-box" value="🐙 GitHub CI/CD &amp; Version Control: [punitgiri921/Azure-Healthcare-Data-Migration] (Phase 1 Task P1-T7)&#xa;• Collaboration Branch: main (All pipeline, dataset, and linked service JSONs synced under /adf/)&#xa;• Publish Branch: adf_publish (Automated ARM deployment templates generated on clicking Publish)&#xa;• Result: Every configuration you made in ADF Studio is safely committed to your git repository!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;fontColor=#0F172A;fontSize=11.5;align=left;spacingLeft=15;lineHeight=1.4;" vertex="1" parent="azure-box">
          <mxGeometry x="30" y="820" width="700" height="110" as="geometry" />
        </mxCell>


        <!-- ========================================================================= -->
        <!-- INTER-CLOUD / HYBRID CONNECTORS & DATA FLOWS                              -->
        <!-- ========================================================================= -->

        <!-- SHIR to ADF Cloud Connection -->
        <mxCell id="edge-shir-adf" value="Outbound HTTPS / TLS 1.3 / Port 443&#xa;Long-Polling Control Channel (Pull Tasks)&#xa;Streams Encrypted Parquet to ADLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=3;fontColor=#0369A1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="shir-box" target="adf-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ADF to Key Vault Secret Read -->
        <mxCell id="edge-adf-akv" value="Retrieves 'sql-onprem-password' via Managed Identity Token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#7E22CE;fontSize=10.5;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="azure-box" source="adf-box" target="akv-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ADF to ADLS Write -->
        <mxCell id="edge-adf-adls" value="Writes Parquet to 'bronze' / Delta to 'silver' &amp; 'gold' via RBAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0891B2;strokeWidth=2;fontColor=#0E7490;fontSize=10.5;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="azure-box" source="adf-box" target="adls-box">
          <mxGeometry relative="1" as="geometry" />
