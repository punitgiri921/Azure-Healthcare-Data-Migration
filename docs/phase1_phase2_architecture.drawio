        <mxCell id="github_hdr" value="&lt;font color='#F1F5F9' style='font-size: 15px; font-weight: bold;'&gt;🐙 GitHub Repository &amp; Enterprise CI/CD&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 12px;'&gt;Repo: &lt;b&gt;punitgiri921/Azure-Healthcare-Data-Migration&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1310" y="220" width="400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="github_details" value="&lt;font color='#CBD5E1' style='font-size: 11px; line-height: 1.6;'&gt;&lt;b&gt;Git Synchronization Topology:&lt;/b&gt;&lt;br/&gt;● &lt;b&gt;Root Directory:&lt;/b&gt; &lt;code&gt;/adf&lt;/code&gt; (Clean separation from SQL/docs)&lt;br/&gt;● &lt;b&gt;Collaboration Branch:&lt;/b&gt; &lt;code&gt;main&lt;/code&gt; (Live JSON pipelines/linked services)&lt;br/&gt;● &lt;b&gt;Publish Branch:&lt;/b&gt; &lt;code&gt;adf_publish&lt;/code&gt; (Compiled ARM templates)&lt;br/&gt;● &lt;b&gt;Commit Sync:&lt;/b&gt; Linked services &amp; IR commits live in repo!&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="265" width="400" height="170" as="geometry" />
