        <mxCell id="adf_hdr" value="&lt;font color='#38BDF8' style='font-size: 16px; font-weight: bold;'&gt;🏭 Azure Data Factory v2 (ETL &amp; Orchestration Engine)&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 12px;'&gt;Name: &lt;b&gt;adf-healthcare-punit01&lt;/b&gt; • System-Assigned Managed Identity (SMI) Enabled&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="830" y="505" width="870" height="35" as="geometry" />
        </mxCell>

        <!-- ADF Sub-components: Linked Services -->
        <mxCell id="ls_kv_box" value="&lt;font color='#FBBF24' style='font-size: 13px; font-weight: bold;'&gt;Linked Service: [ls_keyvault_healthcare]&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 11px;'&gt;Type: Azure Key Vault&lt;br/&gt;Auth: &lt;b&gt;System-Assigned Managed Identity (SMI)&lt;/b&gt;&lt;br/&gt;Target: kv-healthcare-sec01&lt;br/&gt;Purpose: Zero-secret retrieval of DB passwords&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F59E0B;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="555" width="420" height="105" as="geometry" />
        </mxCell>

        <mxCell id="ls_sql_box" value="&lt;font color='#38BDF8' style='font-size: 13px; font-weight: bold;'&gt;Linked Service: [ls_sqlserver_onprem]&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 11px;'&gt;Type: SQL Server (Version 2.0)&lt;br/&gt;Connect Via: &lt;b&gt;shir-onprem-gateway-01&lt;/b&gt;&lt;br/&gt;Target Server: DESKTOP-H5RKB3H\SQLEXPRESS&lt;br/&gt;Target DB: healthcare_emr_source • User: adf_svc_user&lt;br/&gt;Password: Retrieved dynamically from ls_keyvault_healthcare&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0EA5E9;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1290" y="555" width="420" height="105" as="geometry" />
        </mxCell>

        <mxCell id="adf_managed_identity" value="&lt;font color='#10B981' style='font-size: 12px; font-weight: bold;'&gt;🛡️ Zero-Secret Identity Backbone (System-Assigned Managed Identity)&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 11px;'&gt;ADF holds an Entra ID Service Principal with auto-rotated tokens. It accesses Key Vault and ADLS Storage natively without any connection strings or master keys stored in Git!&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#10B981;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="680" width="880" height="55" as="geometry" />
        </mxCell>

        <mxCell id="adf_phase3_preview" value="&lt;font color='#A855F7' style='font-size: 12px; font-weight: bold;'&gt;⚡ Ready for Phase 3 Execution: Pipeline [pl_ingest_incremental_bronze]&lt;/font&gt;&lt;br/&gt;&lt;font color='#CBD5E1' style='font-size: 11px;'&gt;Will execute Lookups on &lt;code&gt;etl_watermark_control&lt;/code&gt; ➔ Extract Delta Rows via SHIR ➔ Sink to ADLS Bronze Parquet ➔ Update Watermark.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581C87;strokeColor=#A855F7;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="745" width="880" height="45" as="geometry" />
        </mxCell>

        <!-- Node: ADLS Gen2 Storage -->
        <mxCell id="box_adls" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1">
