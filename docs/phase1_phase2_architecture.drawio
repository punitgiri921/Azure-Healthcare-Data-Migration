        <!-- Node: Azure Data Factory -->
        <mxCell id="box_adf" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=2.5;verticalAlign=top;" vertex="1" parent="1">
