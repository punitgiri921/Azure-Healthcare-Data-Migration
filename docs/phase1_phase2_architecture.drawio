        <mxCell id="akv_hdr" value="&lt;font color='#FBBF24' style='font-size: 15px; font-weight: bold;'&gt;🔐 Azure Key Vault&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 12px;'&gt;Name: &lt;b&gt;kv-healthcare-sec01&lt;/b&gt; • Permission: Azure RBAC&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="830" y="220" width="400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="akv_secret" value="&lt;font color='#FBBF24' style='font-size: 13px; font-weight: bold;'&gt;Secret: [sql-onprem-password]&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 11px;'&gt;Value: HealthLakehouse2026!Secure&lt;br/&gt;Status: Enabled • Version: Current&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F59E0B;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="265" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="akv_roles" value="&lt;font color='#CBD5E1' style='font-size: 11px; line-height: 1.5;'&gt;&lt;b&gt;RBAC Roles Configured:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Key Vault Secrets User&lt;/b&gt; ➔ Assigned to ADF Managed Identity (Read secret only).&lt;br/&gt;2. &lt;b&gt;Key Vault Secrets Officer&lt;/b&gt; ➔ Assigned to Your Account (Create/edit secrets).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#475569;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="340" width="400" height="95" as="geometry" />
        </mxCell>

        <!-- Node: GitHub Repository Integration -->
        <mxCell id="box_github" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1290" y="210" width="440" height="250" as="geometry" />
