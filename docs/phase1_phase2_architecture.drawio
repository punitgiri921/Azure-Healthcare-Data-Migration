        <mxCell id="adls_hdr" value="&lt;font color='#34D399' style='font-size: 16px; font-weight: bold;'&gt;📦 Azure Data Lake Storage Gen2 (Medallion Lakehouse Storage)&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 12px;'&gt;Name: &lt;b&gt;sthealthcarelake01&lt;/b&gt; • Type: StorageV2 (Blob &amp; DFS) • Hierarchical Namespace (HNS): &lt;b&gt;ENABLED&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="830" y="845" width="880" height="35" as="geometry" />
