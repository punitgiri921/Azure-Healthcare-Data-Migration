        <!-- Title Banner -->
        <mxCell id="title_box" value="&lt;font color='#F8FAFC' style='font-size: 22px; font-weight: bold;'&gt;Azure Healthcare Migration &amp; Medallion Lakehouse — Architecture (Phase 1 &amp; Phase 2)&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 13px;'&gt;Zero-Secret Hybrid Cloud Integration: On-Premises SQL Server to ADLS Gen2 via Self-Hosted Gateway (SHIR) &amp; Azure Key Vault&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;strokeWidth=2;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1720" height="70" as="geometry" />
        </mxCell>

