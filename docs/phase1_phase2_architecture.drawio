          <mxGeometry x="115" y="275" width="300" height="25" as="geometry" />
        </mxCell>

        <!-- Clinical Tables List -->
        <mxCell id="tbl_patients" value="&lt;font color='#38BDF8'&gt;● dbo.patients&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;20 rows (Contains SSN, Names, DOB, Address to be masked)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;align=left;spacingLeft=10;fontColor=#F1F5F9;" vertex="1" parent="1">
          <mxGeometry x="115" y="310" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tbl_encounters" value="&lt;font color='#38BDF8'&gt;● dbo.encounters&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;15 rows (Inpatient, Outpatient, ER visits)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;align=left;spacingLeft=10;fontColor=#F1F5F9;" vertex="1" parent="1">
          <mxGeometry x="115" y="365" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tbl_claims" value="&lt;font color='#38BDF8'&gt;● dbo.claims&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;15 rows (Billed amounts, paid amounts, denials)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;align=left;spacingLeft=10;fontColor=#F1F5F9;" vertex="1" parent="1">
          <mxGeometry x="115" y="420" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tbl_providers" value="&lt;font color='#38BDF8'&gt;● dbo.providers&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;10 rows (Doctors, specialties, NPI numbers)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;align=left;spacingLeft=10;fontColor=#F1F5F9;" vertex="1" parent="1">
          <mxGeometry x="385" y="310" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tbl_diagnoses" value="&lt;font color='#38BDF8'&gt;● dbo.diagnoses&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;17 rows (ICD-10 clinical diagnosis coding)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;align=left;spacingLeft=10;fontColor=#F1F5F9;" vertex="1" parent="1">
          <mxGeometry x="385" y="365" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tbl_watermark" value="&lt;font color='#FBBF24'&gt;● dbo.etl_watermark_control&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 10px;'&gt;5 rows (Baseline: 1970-01-01 for delta load)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#FBBF24;align=left;spacingLeft=10;fontColor=#F1F5F9;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="385" y="420" width="260" height="45" as="geometry" />
        </mxCell>

        <!-- Service User Box -->
        <mxCell id="user_box" value="&lt;font color='#10B981' style='font-size: 13px; font-weight: bold;'&gt;👤 Dedicated Service User: [adf_svc_user]&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 11px;'&gt;Roles: &lt;b&gt;db_datareader&lt;/b&gt; (read clinical data) + &lt;b&gt;db_datawriter&lt;/b&gt; (update high-watermark timestamp)&lt;br/&gt;Password: &lt;i&gt;HealthLakehouse2026!Secure&lt;/i&gt; (Stored safely in Azure Key Vault)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#10B981;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="560" height="85" as="geometry" />
        </mxCell>

        <!-- Node: SQL Server Browser -->
        <mxCell id="box_browser" value="&lt;font color='#E2E8F0' style='font-size: 12px; font-weight: bold;'&gt;🔍 SQL Server Browser Service&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 11px;'&gt;Service: SQLBrowser • Startup: Automatic (Running)&lt;br/&gt;Purpose: Resolves named instance &lt;b&gt;\SQLEXPRESS&lt;/b&gt; for SHIR driver&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;strokeWidth=1;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="600" height="60" as="geometry" />
        </mxCell>

        <!-- Node: SHIR Gateway -->
        <mxCell id="box_shir" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#10B981;strokeWidth=2.5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="600" height="340" as="geometry" />
        </mxCell>
        <mxCell id="shir_hdr" value="&lt;font color='#10B981' style='font-size: 16px; font-weight: bold;'&gt;🛡️ Self-Hosted Integration Runtime (SHIR) Agent&lt;/font&gt;&lt;br/&gt;&lt;font color='#94A3B8' style='font-size: 12px;'&gt;ADF Name: &lt;b&gt;shir-onprem-gateway-01&lt;/b&gt; • Windows Service: &lt;b&gt;DIAHostService&lt;/b&gt; (Running)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="755" width="560" height="35" as="geometry" />
        </mxCell>
        <mxCell id="shir_desc" value="&lt;font color='#CBD5E1' style='font-size: 12px; line-height: 1.6;'&gt;&lt;b&gt;How this Unhackable Bridge Works:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Outbound-Only Polling:&lt;/b&gt; SHIR establishes an outbound TLS 1.3 HTTPS connection over Port 443 to Azure Data Factory queues. Zero incoming firewall ports opened!&lt;br/&gt;2. &lt;b&gt;Internal Query Execution:&lt;/b&gt; When ADF sends a pipeline task, SHIR queries SQL Server locally over loopback LAN (&lt;code&gt;DESKTOP-H5RKB3H\SQLEXPRESS:1433&lt;/code&gt;).&lt;br/&gt;3. &lt;b&gt;Compression &amp; Streaming:&lt;/b&gt; Converts raw relational rows into optimized Parquet batches and streams them directly to Azure Data Lake Storage Gen2.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;align=left;spacing=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="805" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="shir_status" value="&lt;font color='#10B981' style='font-size: 13px; font-weight: bold;'&gt;STATUS: 🟢 CONNECTED &amp; RUNNING (Express Setup Registered)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#10B981;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="975" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="shir_tool" value="&lt;font color='#94A3B8' style='font-size: 11px;'&gt;Managed via Microsoft Integration Runtime Configuration Manager UI in System Tray&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="1025" width="560" height="25" as="geometry" />
        </mxCell>


