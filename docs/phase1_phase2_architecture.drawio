        <!-- Lakehouse Containers -->
        <mxCell id="cnt_bronze" value="&lt;font color='#F59E0B' style='font-size: 14px; font-weight: bold;'&gt;🥉 bronze&lt;/font&gt;&lt;br/&gt;&lt;font color='#CBD5E1' style='font-size: 11px;'&gt;Raw Ingestion Layer&lt;br/&gt;Format: &lt;b&gt;Parquet&lt;/b&gt;&lt;br/&gt;Partitioned by Year/Month&lt;br/&gt;Raw append-only audit trail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#F59E0B;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="830" y="895" width="275" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cnt_silver" value="&lt;font color='#94A3B8' style='font-size: 14px; font-weight: bold;'&gt;🥈 silver&lt;/font&gt;&lt;br/&gt;&lt;font color='#CBD5E1' style='font-size: 11px;'&gt;Cleaned &amp; De-identified&lt;br/&gt;Format: &lt;b&gt;Delta Lake&lt;/b&gt;&lt;br/&gt;HIPAA Masking (SHA-256)&lt;br/&gt;Deduplication &amp; Type casting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#94A3B8;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1132" y="895" width="275" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cnt_gold" value="&lt;font color='#FBBF24' style='font-size: 14px; font-weight: bold;'&gt;🥇 gold&lt;/font&gt;&lt;br/&gt;&lt;font color='#CBD5E1' style='font-size: 11px;'&gt;Curated Analytics Marts&lt;br/&gt;Format: &lt;b&gt;Delta Star Schema&lt;/b&gt;&lt;br/&gt;Dim_Patient, Fact_Claims&lt;br/&gt;Consumed by Synapse &amp; Power BI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#FBBF24;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1435" y="895" width="275" height="115" as="geometry" />
        </mxCell>

        <mxCell id="adls_rbac_note" value="&lt;font color='#10B981' style='font-size: 12px;'&gt;🔐 Role Assignment: &lt;b&gt;Storage Blob Data Contributor&lt;/b&gt; granted to ADF Managed Identity &lt;code&gt;adf-healthcare-punit01&lt;/code&gt;. Zero storage keys required!&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#10B981;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="830" y="1025" width="880" height="35" as="geometry" />
        </mxCell>


        <!-- ================================================================= -->
        <!-- CONNECTIONS & DATA FLOW ARROWS -->
        <!-- ================================================================= -->

        <!-- 1. SHIR pulls from SQL Server -->
        <mxCell id="conn_shir_sql" value="&lt;font color='#38BDF8' style='font-size: 11px; font-weight: bold;'&gt;1. Local Query Loopback&lt;br/&gt;(TCP Port 1433 / adf_svc_user)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=2.5;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="box_shir" target="user_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. SHIR Outbound to ADF -->
        <mxCell id="conn_shir_adf" value="&lt;font color='#10B981' style='font-size: 12px; font-weight: bold;'&gt;2. Outbound Polling &amp; Parquet Stream&lt;br/&gt;(HTTPS / TLS 1.3 / Port 443 / ZERO Inbound Holes)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=3;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_shir" target="ls_sql_box">
          <mxGeometry x="-0.15" y="-15" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="876" />
              <mxPoint x="750" y="608" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 3. ADF fetches secret from Key Vault -->
        <mxCell id="conn_adf_akv" value="&lt;font color='#FBBF24' style='font-size: 11px; font-weight: bold;'&gt;Get Secret: sql-onprem-password&lt;br/&gt;(Managed Identity Token)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ls_kv_box" target="akv_secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. SQL Server Linked Service references Key Vault Linked Service -->
        <mxCell id="conn_sql_ref_kv" value="&lt;font color='#94A3B8' style='font-size: 10px;'&gt;References for Password&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ls_sql_box" target="ls_kv_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. ADF writes to ADLS Gen2 Bronze Container -->
        <mxCell id="conn_adf_bronze" value="&lt;font color='#34D399' style='font-size: 12px; font-weight: bold;'&gt;3. Sinks Raw Parquet to bronze/&lt;br/&gt;(ADLS Gen2 REST API via Managed Identity)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#34D399;strokeWidth=2.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adf_phase3_preview" target="cnt_bronze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. ADF synced to GitHub -->
        <mxCell id="conn_adf_github" value="&lt;font color='#94A3B8' style='font-size: 11px;'&gt;Git Commits JSON under /adf&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_adf" target="github_details">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
