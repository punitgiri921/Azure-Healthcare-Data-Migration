<mxfile host="Electron" modified="2026-09-10T17:40:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="phase1-2-architecture" name="Phase 1 &amp; 2 Full Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1150" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BAR -->
        <mxCell id="title" value="Azure Healthcare Data Migration &amp; Medallion Lakehouse&#xa;Complete Architectural Blueprint: Phase 1 (Cloud Foundation) &amp; Phase 2 (Hybrid Gateway &amp; EMR Setup)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="120" y="25" width="1410" height="50" as="geometry" />
        </mxCell>

        <!-- SUBTITLE -->
        <mxCell id="subtitle" value="Lightweight, Production-Grade Reference Map — Explaining Every Resource, Place, Value, Security Boundary, and Purpose" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="1150" height="25" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- ZONE 1: ON-PREMISES ENVIRONMENT (YOUR LAPTOP)                             -->
        <!-- ========================================================================= -->
        <mxCell id="onprem-box" value="🏢 ON-PREMISES ENVIRONMENT (Your Windows PC / Simulated Hospital Network)&#xa;Host: DESKTOP-H5RKB3H  |  OS: Windows 11  |  Location: Local Workstation" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1E293B;fontSize=14;fontStyle=1;fontFamily=Helvetica;startSize=40;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="580" height="960" as="geometry" />
        </mxCell>

        <!-- SQL Server Container -->
        <mxCell id="sql-box" value="🗄️ Database Engine: Microsoft SQL Server 2022 Express&#xa;Instance: .\SQLEXPRESS (or DESKTOP-H5RKB3H\SQLEXPRESS)&#xa;Service: MSSQL$SQLEXPRESS (Port: 1433 TCP/IP Enabled | Mixed Mode)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#92400E;fontSize=12;fontStyle=1;fontFamily=Helvetica;startSize=50;rounded=1;" vertex="1" parent="onprem-box">
          <mxGeometry x="25" y="60" width="530" height="420" as="geometry" />
        </mxCell>

        <!-- DB healthcare_emr_source -->
        <mxCell id="sql-db" value="📁 Database: [healthcare_emr_source]&#xa;Simulates Legacy Apex Regional Hospital EMR System" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="sql-box">
          <mxGeometry x="20" y="65" width="490" height="45" as="geometry" />
        </mxCell>

        <!-- Tables List -->
        <mxCell id="sql-tables" value="📋 Seeded Clinical &amp; Financial Tables (Phase 2 Task P2-T2):&#xa;• dbo.patients (20 rows) — Synthetic PII: Names, SSN, DOB, Address (Target for Silver Masking)&#xa;• dbo.providers (10 rows) — Doctors, Specialty, Department, NPI Numbers&#xa;• dbo.encounters (15 rows) — Inpatient, Emergency, Outpatient, Telehealth Admissions&#xa;• dbo.diagnoses (17 rows) — Primary &amp; Secondary Clinical ICD-10 Codes (e.g. I21.9, J18.9)&#xa;• dbo.claims (15 rows) — Billing, Paid Amounts, Denial Codes, Insurance Settlements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;fontColor=#451A03;fontSize=11;align=left;spacingLeft=12;lineHeight=1.4;" vertex="1" parent="sql-box">
          <mxGeometry x="20" y="120" width="490" height="110" as="geometry" />
        </mxCell>

        <!-- Watermark Table -->
        <mxCell id="sql-watermark" value="⏱️ Watermark State Engine: [dbo.etl_watermark_control] (Task P2-T3)&#xa;• Tracks: table_name | watermark_column (updated_at) | last_watermark_value&#xa;• Initialized to: '1970-01-01 00:00:00' across all 5 tables for clean baseline initial load&#xa;• Purpose: Enables Phase 3 incremental delta extraction without table locks or triggers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;lineHeight=1.4;" vertex="1" parent="sql-box">
          <mxGeometry x="20" y="240" width="490" height="75" as="geometry" />
        </mxCell>

        <!-- Dedicated User -->
        <mxCell id="sql-user" value="👤 Dedicated Least-Privilege Service Login: [adf_svc_user]&#xa;• Password: HealthLakehouse2026!Secure (Stored in Azure Key Vault)&#xa;• Roles: db_datareader (Read tables) + db_datawriter (Update watermark status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="sql-box">
          <mxGeometry x="20" y="325" width="490" height="50" as="geometry" />
        </mxCell>

        <!-- Windows Tools Used -->
        <mxCell id="tools-note" value="🛠️ Local Management Tools Used:&#xa;• SSMS 20 (SQL Server Management Studio): Verified schema, tables, queries&#xa;• Services.msc: Started MSSQL$SQLEXPRESS &amp; SQL Server Browser (Port Resolution)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="sql-box">
          <mxGeometry x="20" y="380" width="490" height="30" as="geometry" />
        </mxCell>

        <!-- SHIR Agent Box -->
        <mxCell id="shir-box" value="🌉 HYBRID GATEWAY: Self-Hosted Integration Runtime (SHIR)&#xa;Registered Name: shir-onprem-gateway-01  |  Phase 2 Tasks P2-T4 &amp; P2-T5" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1.5;fontColor=#065F46;fontSize=12;fontStyle=1;fontFamily=Helvetica;startSize=45;rounded=1;" vertex="1" parent="onprem-box">
          <mxGeometry x="25" y="520" width="530" height="230" as="geometry" />
        </mxCell>

        <mxCell id="shir-desc" value="• Windows Service Daemon: DIAHostService (🟢 Status: Running)&#xa;• Express Setup Registration: Authenticated to ADF via Key1 token&#xa;• Local Connectivity: Queries .\SQLEXPRESS via loopback (localhost:1433)&#xa;• Local Compute Role: Reads internal relational data, compresses into Snappy Parquet,&#xa;  and pushes streams directly to Azure over encrypted channel&#xa;• Enterprise Security: 0 Inbound firewall ports opened! Never accepts internet traffic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontColor=#047857;fontSize=11;align=left;spacingLeft=12;lineHeight=1.5;" vertex="1" parent="shir-box">
          <mxGeometry x="20" y="60" width="490" height="150" as="geometry" />
        </mxCell>

        <!-- SQL to SHIR Internal Arrow -->
        <mxCell id="arrow-sql-shir" value="Local Queries via ODBC / TCP Port 1433&#xa;(Local Loopback Only — No Internet Exposure)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="onprem-box" source="sql-box" target="shir-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- On-Prem Infosec Badge -->
        <mxCell id="infosec-badge" value="🛡️ HIPAA Network Compliant:&#xa;The corporate/hospital firewall completely blocks all inbound connections.&#xa;The SHIR agent punches zero holes into the perimeter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#F87171;fontColor=#991B1B;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="onprem-box">
          <mxGeometry x="25" y="780" width="530" height="60" as="geometry" />
        </mxCell>

        <!-- Local Git Working Folder -->
        <mxCell id="local-git" value="💻 Local Project Workspace:&#xa;d:\...Azure-Healthcare-Data-Migration\&#xa;• sql/ (DDL, Seed, User Scripts)  • docs/ (Trackers &amp; Roadmaps)  • adf/ (Synced JSONs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="onprem-box">
          <mxGeometry x="25" y="860" width="530" height="60" as="geometry" />
